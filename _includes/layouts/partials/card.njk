{% from "layouts/partials/macros.njk" import card %}

{% set heroImage %}
    {% include 'layouts/partials/hero-image.njk' %}
{% endset %}

<div class="flex flex-col rounded-md h-full shadow-sm p-1">
    {{ card(
        url=(item.url | url),
        title=item.data.title,
        alt=item.data.title,
        pubDate=item.data.date,
        description=item.data.description,
        buttonText=item.data.buttonText,
        heroImage=heroImage,
        isPodcast='/podcasts/' in item.inputPath
    ) }}
</div>